# Leave blank in local development to use Vite's /api proxy.
VITE_API_BASE_URL=/api/v1
# Never put AI_API_KEY or provider secrets here. AI stays on the backend.

# Canonical SEO base URL used for structured data and canonical links.
# In production set this to your deployed origin (e.g. https://qavlio.pk).
VITE_SITE_URL=https://qavlio.pk
