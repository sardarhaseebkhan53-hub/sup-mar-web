{
  "name": "QAVLIO — Buy, Sell & Discover",
  "short_name": "QAVLIO",
  "description": "QAVLIO marketplace — buy and sell verified items near you across Pakistan.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F7F8FC",
