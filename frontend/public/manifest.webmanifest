  "categories": ["shopping", "marketplace", "business"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse Marketplace",
      "url": "/marketplace",
      "description": "Browse all listings"
    },
    {
      "name": "Search",
      "url": "/search",
      "description": "Search listings"
    },
    {
      "name": "Sell an item",
      "url": "/sell",
      "description": "Post a new listing"
    }
  ]
