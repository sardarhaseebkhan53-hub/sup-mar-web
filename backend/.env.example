# Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database — required in production; optional only for local foundation previews
MONGODB_URI=

# Authentication — Phase 2 must replace these with strong, random secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REMEMBER_TTL=30d
OTP_PEPPER=replace-with-a-third-strong-random-secret
OTP_EXPIRES_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10

# Authentication flags — defaults are safe for development
OTP_ENABLED=false
OTP_PROVIDER=console
OTP_CHANNEL=sms
OTP_REQUIRED_FOR_SIGNUP=false
OTP_REQUIRED_FOR_LOGIN=false
OTP_REQUIRED_FOR_PASSWORD_RESET=false

# Browser origins; comma-separated
CLIENT_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Configurable commerce defaults — publish admin-managed PlatformSetting values in production
FREE_LISTING_LIMIT=1
ADDITIONAL_LISTING_FEE=100
LISTING_FEE_CURRENCY=PKR

# Providers — use sandbox only outside production; secrets remain server-side
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=replace-with-a-strong-webhook-signing-secret
PAYMENT_ENVIRONMENT=sandbox
MEDIA_PROVIDER=
CLOUD_STORAGE_KEY=
# Cloudinary direct-upload adapter (required when MEDIA_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AVATAR_MAX_BYTES=5242880
# AI remains server-side. Never put these values in frontend env files.
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=80
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=700
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=QAVLIO <noreply@qavlio.local>
SMS_API_KEY=
RECENTLY_VIEWED_LIMIT=20
ALERT_DAILY_CAP=20

# Social login providers — leave empty to safely disable
# Each provider requires both ID and SECRET to be considered CONFIGURED.
# The admin panel reflects this state in real time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Phase 19 — observability
# Log any MongoDB operation slower than this many milliseconds (empty = disabled)
SLOW_QUERY_THRESHOLD_MS=200

# Development admin seed — NEVER expose to the frontend. Clear after first use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_NAME=QAVLIO Administrator
ADMIN_EMAIL=
